{
  "expo": {
    "name": "Directory Directory",
    "slug": "directory-directory",
    "scheme": "directorydirectory",
    "icon": "./assets/concepts/logos/v15/01-indexed-d-compact-blue.png",
    "orientation": "default",
    "backgroundColor": "#f7f8fa",
    "primaryColor": "#0874f9",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.directorydirectory.app"
    },
    "android": {
      "package": "com.directorydirectory.app"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/icons/favicon-rounded.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
